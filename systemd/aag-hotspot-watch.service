[Unit]
Description=AAG Hotspot owned-session recovery supervisor
After=NetworkManager.service

[Service]
Type=exec
ExecStart=/usr/bin/python3 -I /usr/lib/aag-hotspot/watch.py
User=root
Group=root
UMask=0077
LimitCORE=0
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/aag-hotspot /var/lib/NetworkManager
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
LockPersonality=yes
RestrictSUIDSGID=yes

# Deliberately no [Install] section: on-demand only, never boot activation.
